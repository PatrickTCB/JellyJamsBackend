# Rest API and Playlist Builder
DB_PW=double-secret-password
REST_PORT=8080
REST_IP=127.0.0.1
SHARED_DATA=/data/shared
PLAYLIST_SUFFIX="_automatic"
SERVER_PLAYLIST="Family Blend"
# Audiomuse
AUDIOMUSE_PORT=8000
AUDIOMUSE_TZ="Europe/Berlin"
AUDIOMUSE_POSTGRES_USER=audiomuse
AUDIOMUSE_POSTGRES_PASSWORD=triple-secret-password
AUDIOMUSE_POSTGRES_PORT=5432
AUDIOMUSE_POSTGRES_DATA="/data/db"
AUDIOMUSE_AUDIO_FOLDER="/data/temp-audio"
AUDIOMUSE_PLUGINS="/data/plugins"
# AudioMuse-AI login can either be done
# via user name and pw or API key.
# If you set the API key, then there's no
# need to set the others
#AUDIOMUSE_USER=admin
#AUDIOMUSE_PW=probably-shouldnt-be-admin
AUDIOMUSE_API_KEY=really-shouldnt-be-admin
AUDIOMUSE_HOST="http://audiomuse"